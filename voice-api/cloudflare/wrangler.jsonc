{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mimo-voice-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://aitest-ai.github.io"
  },
  "ratelimits": [
    { "name": "VOICE_RATE_LIMIT", "namespace_id": "424001", "simple": { "limit": 120, "period": 60 } },
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "424002", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
